     /// A busting SOFT reads no memory rows or mutation log, so a memory update waits for the
     /// next HARD fold; a genuine HARD trigger (here a render-config change) shows it in m0.
+    fn r4_full_gate(armed: bool, table: &str) {
+        let dir = tempfile::tempdir().unwrap();
+        let s = store(dir.path());
+        s.seed_memory(1, "git:proj", "ARCHITECTURE", "gate baseline", 50)
+            .unwrap();
+        s.replace_compartments("r4", &[comp(1, 1, 1, "m1msg", "SUMMARY")])
+            .unwrap();
+        let request = req("r4", "cfg0", vec![item("m1msg", 1, "raw")]);
+        assert_eq!(run(&s, &request, &spine()).action, "HARD");
+        if armed {
+            s.arm_soft_refresh("r4").unwrap();
+        }
+        let control = transform(&s, &request, &pctx("git:proj", "/nonexistent-docs", 0)).unwrap();
+        assert_eq!(control.action, if armed { "SOFT" } else { "SOFT+" });
+        if armed {
+            s.arm_soft_refresh("r4").unwrap();
+        }
+        s.with_context_conn_for_test(|tx| {
+            tx.execute_batch(&format!("ALTER TABLE {table} RENAME TO {table}_r4_hidden;"))
+        })
+        .unwrap();
+        let gated = transform(&s, &request, &pctx("git:proj", "/nonexistent-docs", 0));
+        assert!(
+            gated.is_ok(),
+            "armed={armed} table={table}: {:?}",
+            gated.err()
+        );
+    }
+
+    #[test]
+    fn r4_soft_reads_no_memory_watermark() {
+        r4_full_gate(true, "memories");
+    }
+    #[test]
+    fn r4_soft_plus_reads_no_memory_watermark() {
+        r4_full_gate(false, "memories");
+    }
+    #[test]
+    fn r4_soft_reads_no_mutation_log_watermark() {
+        r4_full_gate(true, "memory_mutation_log");
+    }
+    #[test]
+    fn r4_soft_plus_reads_no_mutation_log_watermark() {
+        r4_full_gate(false, "memory_mutation_log");
+    }
