+    #[test]
+    fn r5_randomized_550_passes_mixed_writers_foreign_hards_and_oversized_edits() {
+        let dir = tempfile::tempdir().unwrap();
+        let mut s = store(dir.path());
+        let id = s
+            .insert_memory(memory_input("git:proj", "ARCHITECTURE", "r5 baseline", 0))
+            .unwrap();
+        s.replace_compartments("r5-random", &[comp(1, 1, 1, "m1msg", "SUMMARY")])
+            .unwrap();
+        let request = req("r5-random", "cfg0", vec![item("m1msg", 1, "raw")]);
+        let before = run(&s, &request, &spine());
+        assert_eq!(before.action, "HARD");
+        let mut seed = 0x91ce57bu32;
+        let mut coverage = [0; 6];
+        for i in 0..550 {
+            seed ^= seed << 13;
+            seed ^= seed >> 17;
+            seed ^= seed << 5;
+            let action = if i < 6 { i as usize } else { seed as usize % 6 };
+            coverage[action] += 1;
+            match action {
+                0 => {
+                    s.insert_memory(memory_input(
+                        "git:proj",
+                        "ARCHITECTURE",
+                        &format!("foreign agent insertion {i}"),
+                        i,
+                    ))
+                    .unwrap();
+                }
+                1 => {
+                    s.update_memory_content(
+                        "git:proj",
+                        id,
+                        &format!("own agent update {i}"),
+                        None,
+                        i,
+                    )
+                    .unwrap();
+                }
+                2 => {
+                    let hash = s.get_memory_full(id).unwrap().unwrap().normalized_hash;
+                    let result = s
+                        .set_memory_verification(
+                            "git:proj",
+                            &[mc_store::VerificationUpdate {
+                                memory_id: id,
+                                content_hash_at_prompt: hash,
+                                verification_status: "update".to_string(),
+                                updated_content: Some(format!("automated verify rule {i}")),
+                                archive_reason: None,
+                            }],
+                            i,
+                        )
+                        .unwrap();
+                    assert_eq!(result.accepted, vec![id]);
+                }
+                3 => {
+                    s.update_memory_content(
+                        "git:proj",
+                        id,
+                        &format!("oversized agent edit {i} {}", "detail ".repeat(2500)),
+                        None,
+                        i,
+                    )
+                    .unwrap();
+                }
+                4 => {
+                    let other = req(
+                        "r5-other",
+                        &format!("cfg-{i}"),
+                        vec![item("other", 1, "foreign append")],
+                    );
+                    assert_eq!(run(&s, &other, &spine()).action, "HARD");
+                }
+                _ => {
+                    drop(s);
+                    s = store(dir.path());
+                }
+            }
+            let mut appended = request.clone();
+            appended
+                .messages
+                .push(item(&format!("tail-{i}"), 2, "ordinary append"));
+            let replay = run(&s, &appended, &spine());
+            assert_eq!(replay.action, "SOFT+");
+            assert_eq!(m0_bytes(&replay), m0_bytes(&before));
+            assert_eq!(m1_bytes(&replay), m1_bytes(&before));
+            s.arm_soft_refresh("r5-random").unwrap();
+            let soft = run(&s, &appended, &spine());
+            assert_eq!(soft.action, "SOFT");
+            assert_eq!(m0_bytes(&soft), m0_bytes(&before));
+            assert_eq!(m1_bytes(&soft), m1_bytes(&before));
+        }
+        assert!(coverage.iter().all(|n| *n > 50));
+        eprintln!("r5 Rust seed=0x91ce57b passes=550 coverage={coverage:?}");
+    }
